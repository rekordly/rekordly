generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String            @id @default(cuid())
  name             String?
  email            String?           @unique
  emailVerified    DateTime?
  password         String?
  image            String?
  onboarded        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  activePackageId  String?
  packageEndDate   DateTime?
  packageStartDate DateTime?
  packageStatus    PackageStatus     @default(TRIAL)
  accounts         Account[]
  customers        Customer[]
  digitalAssets    DigitalAsset[]
  expenses         Expense[]
  fixedAssets      FixedAsset[]
  incomeRecords    IncomeRecord[]
  inventoryItems   InventoryItem[]
  invoices         Invoice[]
  loans            Loan[]
  onboarding       OnboardingData?
  ownerEquity      OwnerEquity[]
  payments         Payment[]
  productRecipes   ProductRecipe[]
  productions      Production[]
  purchases        Purchase[]
  quotations       Quotation[]
  sales            Sale[]
  securities       Security[]
  sessions         Session[]
  stockAdjustments StockAdjustment[]
  package          Package?          @relation(fields: [activePackageId], references: [id])

  @@index([email])
}

model Waitlist {
  id          String   @id @default(nanoid(12))
  name        String
  email       String   @unique
  phoneNumber String?
  source      String?  // Where they signed up from (e.g., "landing_page", "navbar")
  referrer    String?  // Referral source
  userAgent   String?  // Browser info
  ipAddress   String?  // IP address
  status      WaitlistStatus @default(PENDING)
  notified    Boolean        @default(false)
  notifiedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

enum WaitlistStatus {
  PENDING     // Waiting for launch
  NOTIFIED    // Has been notified about launch
  CONVERTED   // Signed up for the product
  UNSUBSCRIBED // Opted out
}

model Package {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  price       Float
  duration    Int
  features    Json
  limits      Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@index([isActive])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model OtpCode {
  id        String   @id @default(nanoid())
  email     String
  code      String
  purpose   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model OnboardingData {
  id                   String   @id @default(cuid())
  userId               String   @unique
  fullName             String
  phoneNumber          String
  heardFrom            String
  referralCode         String?
  registrationType     String
  businessName         String?
  startDate            DateTime
  notificationsEnabled Boolean  @default(false)
  termsAccepted        Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  workTypes            String[]
  bankDetails          Json?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Customer {
  id           String       @id @default(nanoid(12))
  userId       String
  name         String
  email        String?
  phone        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  customerRole CustomerRole @default(BUYER)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses     Expense[]
  invoices     Invoice[]
  purchases    Purchase[]
  quotations   Quotation[]
  sales        Sale[]

  @@unique([userId, email, customerRole])
  @@index([userId])
  @@index([userId, customerRole])
  @@index([userId, phone])
}

model InventoryItem {
  id                String             @id @default(nanoid(12))
  userId            String
  itemType          InventoryType
  sku               String?
  name              String
  description       String?
  category          String?
  unit              String             @default("unit")
  trackInventory    Boolean            @default(true)
  quantityOnHand    Float              @default(0)
  reorderLevel      Float?
  reorderQuantity   Float?
  averageCost       Float              @default(0)
  lastPurchaseCost  Float?
  sellingPrice      Float?
  showOnStorefront  Boolean            @default(false)
  storefrontImage   String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe            ProductRecipe?     @relation("RecipeOutput")
  productionOutputs Production[]       @relation("ProductionOutput")
  productionInputs  ProductionInput[]
  purchaseItems     PurchaseItem[]
  recipeIngredients RecipeIngredient[]
  saleItems         SaleItem[]
  stockAdjustments  StockAdjustment[]

  @@unique([userId, sku])
  @@index([userId, itemType])
  @@index([userId, isActive])
  @@index([userId, name])
  @@index([userId, showOnStorefront])
}

model StockAdjustment {
  id                 String         @id @default(ulid())
  userId             String
  inventoryItemId    String
  adjustmentType     AdjustmentType
  quantity           Float
  reason             String
  oldQuantity        Float
  newQuantity        Float
  unitCost           Float?
  totalCost          Float?
  sourcePurchaseId   String?
  adjustmentDate     DateTime       @default(now())
  notes              String?
  createdAt          DateTime       @default(now())
  sourceProductionId String?
  inventoryItem      InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, inventoryItemId])
  @@index([userId, adjustmentDate])
  @@index([adjustmentType])
  @@index([sourceProductionId])
}

model ProductRecipe {
  id                    String             @id @default(nanoid(12))
  userId                String
  name                  String
  description           String?
  category              String?
  outputInventoryItemId String             @unique
  outputQuantity        Float
  defaultLaborCost      Float              @default(0)
  defaultOverheadCost   Float              @default(0)
  recipeImage           String?
  isActive              Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  outputInventory       InventoryItem      @relation("RecipeOutput", fields: [outputInventoryItemId], references: [id])
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  productions           Production[]
  ingredients           RecipeIngredient[]

  @@index([userId, isActive])
  @@index([userId, name])
  @@index([userId, category])
}

model RecipeIngredient {
  id              String        @id @default(ulid())
  recipeId        String
  inventoryItemId String
  quantity        Float
  notes           String?
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  recipe          ProductRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, inventoryItemId])
  @@index([recipeId])
  @@index([inventoryItemId])
}

model Production {
  id                    String            @id @default(nanoid(12))
  userId                String
  productionNumber      String            @unique
  saleId                String?           @unique
  title                 String?
  description           String?
  productionDate        DateTime          @default(now())
  outputItemName        String
  outputQuantity        Float
  outputSellingPrice    Float?
  outputInventoryItemId String
  materialsCost         Float             @default(0)
  laborCost             Float             @default(0)
  overheadCost          Float             @default(0)
  totalCost             Float             @default(0)
  unitCost              Float             @default(0)
  status                ProductionStatus  @default(COMPLETED)
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  batchMultiplier       Float             @default(1)
  outputImage           String?
  recipeId              String?
  outputInventory       InventoryItem     @relation("ProductionOutput", fields: [outputInventoryItemId], references: [id])
  recipe                ProductRecipe?    @relation(fields: [recipeId], references: [id])
  sale                  Sale?             @relation(fields: [saleId], references: [id])
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  inputs                ProductionInput[]
  saleItems             SaleItem[]

  @@index([userId, productionDate])
  @@index([userId, status])
  @@index([recipeId])
  @@index([saleId])
  @@index([outputInventoryItemId])
  @@index([productionNumber])
}

model ProductionInput {
  id              String        @id @default(ulid())
  productionId    String
  inventoryItemId String
  quantity        Float
  unitCost        Float
  totalCost       Float
  notes           String?
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  production      Production    @relation(fields: [productionId], references: [id], onDelete: Cascade)

  @@index([productionId])
  @@index([inventoryItemId])
}

model Quotation {
  id               String          @id @default(nanoid(12))
  quotationNumber  String          @unique
  userId           String
  customerId       String?
  customerName     String?
  customerEmail    String?
  customerPhone    String?
  title            String?
  description      String?
  includeVAT       Boolean         @default(false)
  vatAmount        Float?
  totalAmount      Float
  amountPaid       Float           @default(0)
  balance          Float
  status           QuotationStatus @default(DRAFT)
  validUntil       DateTime?
  issueDate        DateTime        @default(now())
  refundReason     String?
  refundDate       DateTime?
  refundAmount     Float?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  discountAmount   Float           @default(0)
  discountType     DiscountType?
  discountValue    Float?
  lineItems        Json
  subtotal         Float
  payments         Payment[]
  createdPurchases Purchase[]
  customer         Customer?       @relation(fields: [customerId], references: [id])
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, issueDate])
}

model Invoice {
  id            String        @id @default(nanoid(10))
  invoiceNumber String        @unique
  userId        String
  customerId    String?
  customerName  String?
  customerEmail String?
  customerPhone String?
  title         String?
  description   String?
  includeVAT    Boolean       @default(false)
  items         Json
  amount        Float
  vatAmount     Float?
  totalAmount   Float
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  saleId        String?       @unique
  convertedAt   DateTime?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  sale          Sale?         @relation(fields: [saleId], references: [id])
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, issueDate])
}

model Sale {
  id                String         @id @default(nanoid(10))
  receiptNumber     String         @unique
  userId            String
  invoiceId         String?        @unique
  customerId        String?
  customerName      String?
  customerEmail     String?
  customerPhone     String?
  title             String?
  description       String?
  includeVAT        Boolean        @default(false)
  vatAmount         Float?
  totalAmount       Float
  amountPaid        Float          @default(0)
  balance           Float
  status            SaleStatus     @default(UNPAID)
  saleDate          DateTime       @default(now())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deliveryCost      Float          @default(0)
  discountAmount    Float          @default(0)
  discountType      DiscountType?
  discountValue     Float?
  otherSaleExpenses Json?
  refundAmount      Float?
  refundDate        DateTime?
  refundReason      String?
  sourceType        SaleSourceType
  subtotal          Float
  totalSaleExpenses Float          @default(0)
  invoice           Invoice?
  payments          Payment[]
  production        Production?
  customer          Customer?      @relation(fields: [customerId], references: [id])
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  saleItems         SaleItem[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, saleDate])
}

model SaleItem {
  id              String         @id @default(ulid())
  saleId          String
  inventoryItemId String?
  productionId    String?
  itemName        String
  description     String?
  quantity        Float
  unitPrice       Float
  amount          Float
  costPrice       Float          @default(0)
  totalCost       Float          @default(0)
  profit          Float          @default(0)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  production      Production?    @relation(fields: [productionId], references: [id])
  sale            Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([inventoryItemId])
  @@index([productionId])
}

model Purchase {
  id                String         @id @default(nanoid(10))
  purchaseNumber    String         @unique
  userId            String
  vendorName        String
  vendorEmail       String?
  vendorPhone       String?
  title             String?
  description       String?
  otherCosts        Json?
  otherCostsTotal   Float          @default(0)
  subtotal          Float
  includeVAT        Boolean        @default(false)
  vatAmount         Float?
  totalAmount       Float
  amountPaid        Float          @default(0)
  balance           Float
  status            PurchaseStatus @default(UNPAID)
  purchaseDate      DateTime       @default(now())
  refundReason      String?
  refundDate        DateTime?
  refundAmount      Float?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  customerId        String?
  attachments       Json?
  purchaseType      PurchaseType
  sourceQuotationId String?
  payments          Payment[]
  customer          Customer?      @relation(fields: [customerId], references: [id])
  sourceQuotation   Quotation?     @relation(fields: [sourceQuotationId], references: [id])
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             PurchaseItem[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, purchaseDate])
  @@index([userId, customerId])
  @@index([userId, purchaseType])
  @@index([sourceQuotationId])
}

model PurchaseItem {
  id              String         @id @default(ulid())
  purchaseId      String
  inventoryItemId String?
  itemName        String
  description     String?
  quantity        Float
  unitPrice       Float
  amount          Float
  unit            String         @default("unit")
  sku             String?
  category        String?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  purchase        Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([inventoryItemId])
}

model Payment {
  id            String          @id @default(ulid())
  saleId        String?
  amount        Float
  paymentDate   DateTime        @default(now())
  paymentMethod PaymentMethod
  reference     String?
  notes         String?
  createdAt     DateTime        @default(now())
  category      PaymentCategory
  payableType   PayableType
  purchaseId    String?
  quotationId   String?
  userId        String
  incomeId      String?
  expensesId    String?
  loanId        String?
  expenses      Expense?        @relation(fields: [expensesId], references: [id], onDelete: Cascade)
  income        IncomeRecord?   @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  loan          Loan?           @relation(fields: [loanId], references: [id], onDelete: Cascade)
  purchase      Purchase?       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  quotation     Quotation?      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  sale          Sale?           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, payableType])
  @@index([userId, saleId])
  @@index([userId, quotationId])
  @@index([userId, purchaseId])
  @@index([userId, incomeId])
  @@index([userId, expensesId])
  @@index([userId, loanId])
  @@index([userId, paymentDate])
}

model IncomeRecord {
  id                String             @id @default(ulid())
  userId            String
  mainCategory      IncomeMainCategory
  subCategory       IncomeSubCategory
  grossAmount       Float
  description       String?
  date              DateTime           @default(now())
  isRefund          Boolean            @default(false)
  refundReason      String?
  attachments       Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  customSubCategory String?
  refundDate        DateTime?
  taxablePercentage Float?
  linkedLoanId      String?
  amountPaid        Float              @default(0)
  balance           Float              @default(0)
  status            IncomeRecordStatus @default(UNPAID)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments          Payment[]

  @@index([userId, mainCategory])
  @@index([userId, date])
  @@index([userId, subCategory])
  @@index([userId, mainCategory, date])
  @@index([userId, isRefund])
  @@index([userId, linkedLoanId])
  @@index([userId, status])
}

model Expense {
  id                  String          @id @default(ulid())
  userId              String
  category            ExpenseCategory
  subCategory         String?
  amount              Float
  description         String
  date                DateTime        @default(now())
  isDeductible        Boolean         @default(true)
  deductionPercentage Int             @default(100)
  isReturn            Boolean         @default(false)
  returnReason        String?
  receipt             String?
  attachments         Json?
  reference           String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  customerId          String?
  vendorName          String?
  returnDate          DateTime?
  note                String?
  linkedLoanId        String?
  amountPaid          Float           @default(0)
  balance             Float           @default(0)
  status              ExpenseStatus   @default(UNPAID)
  customer            Customer?       @relation(fields: [customerId], references: [id])
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments            Payment[]

  @@index([userId, category])
  @@index([userId, date])
  @@index([userId, isDeductible])
  @@index([userId, category, date])
  @@index([userId, isReturn])
  @@index([userId, customerId])
  @@index([userId, linkedLoanId])
  @@index([userId, status])
}

model Loan {
  id                String           @id @default(nanoid(12))
  userId            String
  loanNumber        String           @unique
  loanType          LoanType
  principalAmount   Float
  interestRate      Float
  startDate         DateTime
  endDate           DateTime?
  term              Int?
  paymentFrequency  PaymentFrequency
  currentBalance    Float
  totalPaid         Float            @default(0)
  totalInterestPaid Float            @default(0)
  status            LoanStatus       @default(ACTIVE)
  purpose           String?
  collateral        String?
  notes             String?
  attachments       Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  insuranceFee      Float            @default(0)
  managementFee     Float            @default(0)
  otherCharges      Float            @default(0)
  partyEmail        String?
  partyName         String
  partyPhone        String?
  processingFee     Float            @default(0)
  totalCharges      Float            @default(0)
  termUnit          TermUnit         @default(MONTHS)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments          Payment[]

  @@index([userId, loanType])
  @@index([userId, status])
  @@index([userId, startDate])
}

model OwnerEquity {
  id              String     @id @default(ulid())
  userId          String
  type            EquityType
  amount          Float
  date            DateTime   @default(now())
  shareholderName String?
  description     String?
  reference       String?
  notes           String?
  attachments     Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, date])
}

model FixedAsset {
  id               String             @id @default(nanoid(12))
  userId           String
  name             String
  category         FixedAssetCategory
  acquisitionCost  Float
  acquisitionDate  DateTime
  currentValue     Float
  depreciationRate Float?
  residualValue    Float              @default(0)
  valueHistory     Json?
  disposalDate     DateTime?
  disposalProceeds Float?
  capitalGain      Float?
  description      String?
  status           AssetStatus        @default(ACTIVE)
  attachments      Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, category])
  @@index([userId, acquisitionDate])
}

model DigitalAsset {
  id           String           @id @default(nanoid(12))
  userId       String
  type         DigitalAssetType
  name         String
  symbol       String?
  quantity     Float
  averageCost  Float
  currentValue Float
  transactions Json[]
  totalGains   Float            @default(0)
  totalLosses  Float            @default(0)
  description  String?
  status       AssetStatus      @default(ACTIVE)
  attachments  Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, status])
}

model Security {
  id                String       @id @default(nanoid(12))
  userId            String
  type              SecurityType
  symbol            String
  name              String
  exchange          String?
  quantity          Float
  averageCost       Float
  currentValue      Float
  transactions      Json[]
  dividendsReceived Float        @default(0)
  interestReceived  Float        @default(0)
  totalGains        Float        @default(0)
  totalLosses       Float        @default(0)
  status            AssetStatus  @default(ACTIVE)
  description       String?
  attachments       Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, status])
}

enum PackageStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

enum CustomerRole {
  BUYER
  SUPPLIER
}

enum InventoryType {
  RAW_MATERIAL
  FINISHED_GOOD
  PRODUCED_ITEM
  SERVICE
  CONSUMABLE
}

enum AdjustmentType {
  RESTOCK
  SALE
  DAMAGE
  RETURN
  CORRECTION
  PRODUCTION
  THEFT
  FOUND
  EXPIRED
  USED
  OTHER
}

enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  UNPAID
  PARTIALLY_PAID
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  SENT
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum InvoiceStatus {
  DRAFT
  SENT
  CONVERTED
  OVERDUE
  CANCELLED
}

enum SaleSourceType {
  DIRECT
  FROM_INVOICE
}

enum SaleStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PurchaseType {
  INVENTORY_RESTOCK
  BUSINESS_EXPENSE
  ASSET_PURCHASE
  PERSONAL_EXPENSE
}

enum PurchaseStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PayableType {
  QUOTATION
  SALE
  PURCHASE
  OTHER_INCOME
  OTHER_EXPENSES
  LOAN
}

enum PaymentCategory {
  INCOME
  EXPENSE
