# API and migration configuration. Never commit api/.env.local.
ENVIRONMENT=local
DATABASE_URL=postgres://rekordly:rekordly_local@rekordly-postgres:5432/rekordly?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=1
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_HEALTH_TIMEOUT=2s
SESSION_TTL=24h
JWT_SIGNING_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3000
PORT=8080
FRONTEND_BASE_URL=http://localhost:3000

# Google OAuth: add GOOGLE_REDIRECT_URL exactly as an Authorized redirect URI
# in Google Cloud Console. The web callback safely sends Google's one-time
# code to the API; do not expose GOOGLE_CLIENT_SECRET to the web app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google/callback

# Private financial evidence uploads. These values stay in api/.env.local only.
# Cloudinary evidence uses authenticated delivery; do not configure an unsigned public upload preset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Blueprint 12: Server-side AI providers (never expose keys to frontend)
AI_DEFAULT_PROVIDER=gemini
AI_FALLBACK_PROVIDER=deepseek
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_MAX_INPUT_CHARS=2000
AI_MAX_OUTPUT_TOKENS=1500

# Blueprint 13: Commercial Mode & Paystack (server-side only; keep controlled_beta until paid launch gates pass)
COMMERCIAL_MODE=controlled_beta
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co
